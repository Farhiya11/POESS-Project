
<?xml version="1.0" encoding="UTF-8"?>

<dcr:definitions
    xmlns:dcr="http://tk/schema/dcr"
    xmlns:dcrDi="http://tk/schema/dcrDi"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC">

    <dcr:dcrGraph id="DMI_WaterLevelMonitoring">

        <!-- Water level observation -->
        <dcr:event
            id="WaterLevelObserved"
            role="DMI"
            description="Water level observed"
            included="true"
            executed="false"
            pending="false" />

        <!-- Threshold evaluation -->
        <dcr:event
            id="WaterLevelEvaluated"
            role="DMI"
            description="Evaluate water level"
            included="true"
            executed="false"
            pending="false" />

        <!-- Warning activation -->
        <dcr:event
            id="WarningLevelActivated"
            role="DMI"
            description="Activate warning level"
            included="true"
            executed="false"
            pending="false" />

        <!-- Authority notification -->
        <dcr:event
            id="AuthoritiesNotified"
            role="DMI"
            description="Notify authorities"
            included="true"
            executed="false"
            pending="false" />

        <!-- Process relations -->

        <dcr:relation
            id="Relation_Observation_Evaluation"
            type="condition"
            sourceRef="WaterLevelObserved"
            targetRef="WaterLevelEvaluated" />

        <dcr:relation
            id="Relation_Evaluation_Warning"
            type="condition"
            sourceRef="WaterLevelEvaluated"
            targetRef="WarningLevelActivated" />

        <dcr:relation
            id="Relation_Warning_Notification"
            type="response"
            sourceRef="WarningLevelActivated"
            targetRef="AuthoritiesNotified" />

        </dcr:dcrGraph>

        <!-- Graphical representation -->

        <dcrDi:dcrRootBoard id="dcrRootBoard">

            <dcrDi:dcrPlane
                id="dcrPlane"
                boardElement="DMI_WaterLevelMonitoring">

                <dcrDi:dcrShape
                    id="WaterLevelObserved_di"
                    boardElement="WaterLevelObserved">
                    <dc:Bounds x="100" y="200" width="150" height="100"/>
                </dcrDi:dcrShape>

                <dcrDi:dcrShape
                    id="WaterLevelEvaluated_di"
                    boardElement="WaterLevelEvaluated">
                    <dc:Bounds x="350" y="200" width="150" height="100"/>
                </dcrDi:dcrShape>

                <dcrDi:dcrShape
                    id="WarningLevelActivated_di"
                    boardElement="WarningLevelActivated">
                    <dc:Bounds x="600" y="200" width="150" height="100"/>
                </dcrDi:dcrShape>

                <dcrDi:dcrShape
                    id="AuthoritiesNotified_di"
                    boardElement="AuthoritiesNotified">
                    <dc:Bounds x="850" y="200" width="150" height="100"/>
                </dcrDi:dcrShape>

                <dcrDi:relation
                    id="Relation_Observation_Evaluation_di"
                    boardElement="Relation_Observation_Evaluation">
                    <dcrDi:waypoint x="250" y="250"/>
                    <dcrDi:waypoint x="350" y="250"/>
                </dcrDi:relation>

                <dcrDi:relation
                    id="Relation_Evaluation_Warning_di"
                    boardElement="Relation_Evaluation_Warning">
                    <dcrDi:waypoint x="500" y="250"/>
                    <dcrDi:waypoint x="600" y="250"/>
                </dcrDi:relation>

                <dcrDi:relation
                    id="Relation_Warning_Notification_di"
                    boardElement="Relation_Warning_Notification">
                    <dcrDi:waypoint x="750" y="250"/>
                    <dcrDi:waypoint x="850" y="250"/>
                </dcrDi:relation>

            </dcrDi:dcrPlane>

        </dcrDi:dcrRootBoard>

    </dcr:definitions>
