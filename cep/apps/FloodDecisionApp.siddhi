@App:name("FloodDecisionApp")

@source(
    type='http',
    receiver.url="http://0.0.0.0:7076/events",
    @map(type='json', fail.on.missing.attribute='false')
)
define stream DmiEventStream(
    event_type string,
    station_id string,
    observed_at string,
    sea_level_cm double,
    parameter_id string,
    location_id string,
    lon double,
    lat double,
    forecast_for string,
    lead_time_hours double,
    collection string,
    source string,
    ingested_at string
);

@sink(
    type='http',
    publisher.url='http://event_logs_service:5010/log',
    method='POST',
    @map(type='json')
)
define stream SourceEventLog(
    event string,
    case_id string,
    order_id string,
    timestamp string,
    role string,
    payload string,
    error string,
    event_type string,
    station_id string,
    observed_at string,
    sea_level_cm double,
    parameter_id string,
    location_id string,
    lon double,
    lat double,
    forecast_for string,
    lead_time_hours double,
    collection string,
    source string,
    ingested_at string
);

@sink(
    type='http',
    publisher.url='http://event_logs_service:5010/log',
    method='POST',
    @map(type='json')
)
define stream DecisionLog(
    event string,
    case_id string,
    order_id string,
    timestamp string,
    role string,
    payload string,
    error string,
    decision string,
    reason string,
    source_event_type string,
    sea_level_cm double,
    lead_time_hours double
);

define stream StormSurgeDecision(
    order_id string,
    timestamp string,
    station_id string,
    sea_level_cm double,
    parameter_id string
);

define stream ForecastWarningDecision(
    order_id string,
    timestamp string,
    location_id string,
    sea_level_cm double,
    lead_time_hours double
);

from DmiEventStream
select event_type as event,
       ifThenElse(station_id is null, location_id, station_id) as case_id,
       ifThenElse(station_id is null, location_id, station_id) as order_id,
       ifThenElse(event_type == "WaterLevelObserved", observed_at, forecast_for) as timestamp,
       source as role,
       "" as payload,
       "" as error,
       event_type,
       station_id,
       observed_at,
       sea_level_cm,
       parameter_id,
       location_id,
       lon,
       lat,
       forecast_for,
       lead_time_hours,
       collection,
       source,
       ingested_at
insert into SourceEventLog;


from DmiEventStream[
    event_type == "WaterLevelObserved" and
    not(sea_level_cm is null) and
    1 == 0
]
select station_id as order_id,
       observed_at as timestamp,
       station_id,
       sea_level_cm,
       parameter_id
insert into StormSurgeDecision;

from DmiEventStream[
    event_type == "SeaLevelForecasted" and
    not(sea_level_cm is null) and
    not(lead_time_hours is null) and
    1 == 0
]
select location_id as order_id,
       forecast_for as timestamp,
       location_id,
       sea_level_cm,
       lead_time_hours
insert into ForecastWarningDecision;

from StormSurgeDecision
select "Storm Surge Decision" as event,
       order_id as case_id,
       order_id,
       timestamp,
       "siddhi" as role,
       "" as payload,
       "" as error,
       "StormSurgeCandidate" as decision,
       "Policy gate is open and observation threshold matched" as reason,
       "WaterLevelObserved" as source_event_type,
       sea_level_cm,
       0.0 as lead_time_hours
insert into DecisionLog;

from ForecastWarningDecision
select "Forecast Warning Decision" as event,
       order_id as case_id,
       order_id,
       timestamp,
       "siddhi" as role,
       "" as payload,
       "" as error,
       "ForecastWarningCandidate" as decision,
       "Policy gate is open and forecast policy matched" as reason,
       "SeaLevelForecasted" as source_event_type,
       sea_level_cm,
       lead_time_hours
insert into DecisionLog;
